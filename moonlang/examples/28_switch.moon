# Switch statement
day = 2

switch day:
    case 1:
        print("Monday")
    case 2:
        print("Tuesday")
    case 3:
        print("Wednesday")
    default:
        print("Other day")
end

# Another example
fruit = "apple"
switch fruit:
    case "apple":
        print("It's an apple")
    case "banana":
        print("It's a banana")
    default:
        print("Unknown fruit")
end
