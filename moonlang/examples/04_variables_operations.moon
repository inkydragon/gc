# Basic operations
a = 10
b = 3
print("Add:", a + b)    # 13
print("Sub:", a - b)    # 7
print("Mul:", a * b)    # 30
print("Div:", a / b)    # 3.333...
print("Mod:", a % b)    # 1

# String concatenation
first = "Moon"
last = "Lang"
full = first + last
print(full)  # MoonLang

# Type conversion
num = 42
text = str(num)
print("Number to string:", text)
print("String to number:", int("123"))
