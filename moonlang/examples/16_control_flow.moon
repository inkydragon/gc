# Control flow examples
age = 15

if age >= 18:
    print("Adult")
elif age >= 13:
    print("Teenager")
else:
    print("Child")
end

# While loop
count = 0
while count < 3:
    print("Count:", count)
    count = count + 1
end

# For loop with list
fruits = ["apple", "banana"]
for fruit in fruits:
    print("Fruit:", fruit)
end

# Range loop
for i = 1 to 3:
    print("i =", i)
end
