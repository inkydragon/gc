# Lists
numbers = [1, 2, 3, 4, 5]
fruits = ["apple", "banana", "orange"]

# Access elements
first = numbers[0]   # 1
last = numbers[-1]   # 5 (should be, if supported)

print("numbers:", numbers)
print("fruits:", fruits)
print("first:", first)
print("len(numbers):", len(numbers))

# List iteration
for num in numbers:
    print("num:", num)
end
